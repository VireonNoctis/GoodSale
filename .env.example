# -----------------------------------------------------------------------------
# GoodSale — copy to .env.local and fill values
# Marked [REQUIRED] must be set for production (NEXT_PUBLIC_DEMO_MODE=false).
# -----------------------------------------------------------------------------

# --- Core ---
NEXT_PUBLIC_DEMO_MODE=false
NEXT_PUBLIC_APP_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000
# Optional Rust API. Set to http://localhost:8080 when running backend/ locally.
RUST_BACKEND_URL=
RUST_BACKEND_ALLOWED_ORIGINS=http://localhost:3000

# --- Supabase [REQUIRED] ---
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role — server only, never expose to the browser
SUPABASE_SERVICE_ROLE_KEY=

# --- Paystack [REQUIRED for live checkout + payouts] ---
# Dashboard → Settings → API Keys & Webhooks
# Use test keys (pk_test_ / sk_test_) until go-live, then switch to live.
NEXT_PUBLIC_PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=
# Prefer the Webhook secret from Paystack; secret key works as fallback
PAYSTACK_WEBHOOK_SECRET=
# Optional fallback when bank name cannot be mapped (e.g. 058 = GTBank)
PAYSTACK_DEFAULT_BANK_CODE=

# --- Google Maps [REQUIRED for SafeMeet + live GoodDispatch map] ---
# Enable: Maps JavaScript API, Maps Embed API, Geocoding API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=

# --- Gemini AI (optional — listing assist / search tips) ---
GEMINI_API_KEY=

# --- Email via Resend (optional — dispute / payout notifications) ---
RESEND_API_KEY=
EMAIL_FROM=GoodSale <noreply@yourdomain.com>

# --- Rate limiting ---
# Rust API: Redis is required in production and defaults to a private Compose Redis service.
REDIS_URL=redis://localhost:6379
RATE_LIMIT_REQUIRE_REDIS=false
# Required for Docker Compose: shared secret between Next.js and the internal Rust limiter.
RATE_LIMIT_SHARED_SECRET=
# Private Next.js-to-Rust service calls (webhook reconciliation, referral attribution).
RUST_INTERNAL_SECRET=
TRUST_PROXY_HEADERS=false
# Set only to a header overwritten by your trusted reverse proxy (e.g. x-real-ip).
TRUSTED_CLIENT_IP_HEADER=
# Legacy Next API handlers: Upstash REST is used for distributed throttling when configured.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Cloudinary (optional — server-side signed public media uploads) ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- Observability (optional) ---
LOG_LEVEL=info
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
